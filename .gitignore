# Ignore documents and images
*.pdf
*.png
!docs/screenshots/*.png
*.jpg
*.jpeg
*.tiff
*.bmp

# Dependencies and build outputs
node_modules/
dist/
target/
*.obj
*.class

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
backup_oracle/
