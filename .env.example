# ==============================================================================
# Airport Management System - Multi-Tier Production & Docker Configuration
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# --- Node.js API Gateway Configuration ---
NODE_ENV=production
PORT=5000
API_PREFIX=/api

# Security Keys (Change in production)
JWT_SECRET=production_jwt_passphrase_key_must_be_random_and_secure
JWT_EXPIRES_IN=24h
COOKIE_SECRET=production_cookie_encryption_key_must_be_random_and_secure

# Allowed CORS Origins for Web Clients (Comma-separated)
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Autonomous Airport Data Engine (AADE) Analysis Frequency (in milliseconds)
AADE_INTERVAL_MS=60000

# --- Oracle Database Configuration ---
# When running backend in Docker:
# - Connects to Oracle XE running on host via `host.docker.internal:1521/XEPDB1`
# - Or specify remote Oracle DB host: `db.myhost.com:1521/XEPDB1`
DB_USER=airport_admin
DB_PASSWORD=your_secure_oracle_password
DB_CONNECT_STRING=host.docker.internal:1521/XEPDB1
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
DB_POOL_TIMEOUT=60

# --- Java OOP Domain Microservice Configuration ---
# Container DNS name within Docker Compose network
JAVA_SERVICE_URL=http://java-service:5050
JAVA_PORT=5050

# --- C Algorithm Engine Configuration ---
# Path to compiled C Linux ELF binary inside backend container
C_ENGINE_PATH=/app/c-engine/c-engine

# --- React Frontend Configuration ---
FRONTEND_PORT=80
VITE_API_URL=/api
