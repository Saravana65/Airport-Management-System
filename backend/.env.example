# ==============================================================================
# Airport Management System Backend - Environment Configuration
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Oracle Database Configuration
# In oracledb v6+, Thin Mode is the default and does not require Oracle Instant Client.
DB_USER=airport_admin
DB_PASSWORD=your_secure_password
DB_CONNECT_STRING=localhost:1521/XEPDB1

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
DB_POOL_TIMEOUT=60
