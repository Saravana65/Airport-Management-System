# ==============================================================================
# Airport Management System Backend - Environment Configuration
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Security & Authentication Configuration
JWT_SECRET=super_secret_airport_jwt_passphrase_key_change_in_production
JWT_EXPIRES_IN=24h
COOKIE_SECRET=secure_airport_cookie_encryption_key_change_in_production

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=airport_management_db
DB_CONNECTION_LIMIT=10
